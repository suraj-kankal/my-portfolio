            "description": "Get only unread/new contact submissions"
          }
        },
        {
          "name": "9️⃣  View Specific Contact",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer admin_token_12345",
                "type": "text"
              }
            ],
            "url": {
              "raw": "http://localhost:3000/api/admin/contacts/1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "admin", "contacts", "1"]
            },
            "description": "Get a specific contact by ID (replace 1 with actual ID)"
          }
        },
        {
          "name": "🔟  Update Contact Status",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer admin_token_12345",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"replied\"\n}"
            },
            "url": {
              "raw": "http://localhost:3000/api/admin/contacts/1/status",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "admin", "contacts", "1", "status"]
            },
            "description": "Update status: new, replied, or archived (replace 1 with ID)"
          }
        },
        {
          "name": "1️⃣1️⃣  Delete Contact",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer admin_token_12345",
                "type": "text"
              }
            ],
            "url": {
              "raw": "http://localhost:3000/api/admin/contacts/1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "admin", "contacts", "1"]
            },
            "description": "Delete a contact from database (replace 1 with ID)"
          }
        },
        {
          "name": "1️⃣2️⃣  View Statistics",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer admin_token_12345",
                "type": "text"
