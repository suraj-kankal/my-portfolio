    {
      "name": "📊 DATABASE OPERATIONS (Admin)",
      "description": "View and manage contact submissions - Requires Authentication",
      "item": [
        {
          "name": "7️⃣  View ALL Contacts",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer admin_token_12345",
                "type": "text"
              }
            ],
            "url": {
              "raw": "http://localhost:3000/api/admin/contacts",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "admin", "contacts"]
            },
            "description": "Get all contact submissions from database with statistics"
          }
        },
        {
          "name": "8️⃣  View NEW Contacts Only",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer admin_token_12345",
                "type": "text"
              }
            ],
            "url": {
              "raw": "http://localhost:3000/api/admin/contacts/new",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "admin", "contacts", "new"]
