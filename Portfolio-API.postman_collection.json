{
  "info": {
    "name": "Portfolio API",
    "description": "Test secure portfolio APIs with public and protected endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "admin_token_12345",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "📍 SERVER INFO",
      "item": [
        {
          "name": "Home - Server Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": [""]
            }
          }
        }
      ]
    },
    {
      "name": "🔓 PUBLIC ENDPOINTS",
      "description": "No authentication required",
      "item": [
        {
          "name": "1️⃣  Get All Portfolio Data",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/api/portfolio",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "portfolio"]
            },
            "description": "Fetches all public portfolio information (skills, experience, education)"
          }
        },
        {
          "name": "2️⃣  Get Skills Only",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/api/skills",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "skills"]
            }
          }
        },
        {
          "name": "3️⃣  Get Experience",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/api/experience",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "experience"]
            }
          }
        },
        {
          "name": "4️⃣  Get Education",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/api/education",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "education"]
            }
          }
        },
        {
          "name": "5️⃣  Submit Contact Form",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"subject\": \"Great Portfolio!\",\n  \"message\": \"I'm interested in your work. Let's connect!\"\n}"
            },
            "url": {
              "raw": "http://localhost:3000/api/contact",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "contact"]
            },
            "description": "Submit a contact form. No authentication needed."
          }
        }
      ]
    },
    {
      "name": "🔒 PROTECTED ENDPOINTS (Authentication Required)",
      "description": "Requires Authorization header with token",
      "item": [
        {
          "name": "5️⃣  Get Private Data (Admin Only)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer admin_token_12345",
                "type": "text",
                "description": "This data is HIDDEN from browser - only visible here with token"
              }
            ],
            "url": {
              "raw": "http://localhost:3000/api/private-data",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "private-data"]
            },
            "description": "Get sensitive private data. REQUIRES valid authentication token. This data is NOT visible in browser inspect mode!"
          }
        },
        {
          "name": "6️⃣  Admin - Update Portfolio",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer admin_token_12345",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"update_profile\",\n  \"payload\": {\n    \"title\": \"Senior Full Stack Developer\",\n    \"skills\": [\"Java\", \"Spring Boot\", \"React\", \"Kubernetes\"]\n  }\n}"
            },
            "url": {
              "raw": "http://localhost:3000/api/admin",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "admin"]
            },
            "description": "Admin endpoint to update portfolio. REQUIRES authentication."
          }
        }
      ]
    },
    {
      "name": "❌ TEST ERROR CASES",
      "description": "Test error handling",
      "item": [
        {
          "name": "Missing Authentication Token",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/api/private-data",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "private-data"]
            },
            "description": "Try accessing protected endpoint WITHOUT token - should get 401 error"
          }
        },
        {
          "name": "Invalid Authentication Token",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer wrong_token_123",
                "type": "text"
              }
            ],
            "url": {
              "raw": "http://localhost:3000/api/private-data",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "private-data"]
            },
            "description": "Try with wrong token - should get 403 error"
          }
        },
        {
          "name": "Missing Required Fields in Contact",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John\"\n}"
            },
            "url": {
              "raw": "http://localhost:3000/api/contact",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "contact"]
            },
            "description": "Send incomplete contact form - should get 400 error"
          }
        }
      ]
    }
  ]
}
